{
  "name": "neon-vaults",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "levels": "node scripts/generate-levels.mjs --write-production",
    "analyze:levels": "node tools/analyze-levels.mjs",
    "analyze:pilot": "node tools/analyze-levels.mjs --pilot",
    "levels:pilot": "node tools/generate-pilot-levels.mjs",
    "validate:pilot": "node tools/validate-pilot.mjs",
    "levels:finalize": "node tools/finalize-campaign-levels.mjs --write-production",
    "report:campaign": "node tools/report-campaign.mjs --output=reports/final-campaign-report",
    "validate": "node tools/validate-project.mjs && node tools/validate-levels.mjs && npm run report:campaign",
    "build": "node scripts/build.mjs && npm run audit:compatibility",
    "audit:compatibility": "node tools/audit-compatibility.mjs",
    "smoke:browser": "node tools/browser-smoke.mjs",
    "test": "node --test tests/*.test.mjs",
    "qa": "npm run validate && npm run test && npm run build && node --check dist/game.js && node tools/verify-production-bundle.mjs",
    "package": "npm run qa && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package.ps1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "esbuild": "^0.25.9"
  }
}
